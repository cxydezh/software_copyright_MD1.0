<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <!-- 禁用Python处理器，使用URL重写 -->
      <!-- <add name="PythonHandler" path="*" verb="*" 
           modules="FastCgiModule" 
           scriptProcessor="C:\inetpub\wwwroot\Software_copyright_MS1.0\.venv\Scripts\python.exe|C:\inetpub\wwwroot\Software_copyright_MS1.0\.venv\Lib\site-packages\wfastcgi.py"
           resourceType="Unspecified" requireAccess="Script" /> -->
    </handlers>
    
    <!-- URL重写规则 - 重定向到Flask服务器 -->
    <rewrite>
      <rules>
        <rule name="Flask Redirect" stopProcessing="true">
          <match url=".*" />
          <action type="Redirect" url="http://47.111.186.20:5000/{R:0}" redirectType="Temporary" />
        </rule>
      </rules>
    </rewrite>
    
    <!-- 静态文件处理 -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
    </staticContent>
    
    <!-- 安全头设置 -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
      </customHeaders>
    </httpProtocol>
    
    <!-- 错误页面 -->
    <httpErrors errorMode="Custom" defaultResponseMode="ExecuteURL">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" responseMode="ExecuteURL" path="/" />
    </httpErrors>
  </system.webServer>
  
  <appSettings>
    <add key="WSGI_HANDLER" value="wsgi.application" />
    <add key="PYTHONPATH" value="C:\inetpub\wwwroot\Software_copyright_MS1.0" />
    <add key="FLASK_CONFIG" value="production" />
    <add key="WSGI_LOG" value="C:\inetpub\logs\software_copyright.log" />
    <add key="WSGI_RESTART_FILE_REGEX" value=".*\.(py|config)$" />
    <add key="SECRET_KEY" value="dev-secret-key-change-in-production" />
    <add key="DB_PASSWORD" value="SoftwareCopyright2024!" />
  </appSettings>
</configuration>